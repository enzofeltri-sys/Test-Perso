# Copier en `.env` pour lancer retrain.py / web_app.py en local (dev/test
# uniquement — le déploiement réel se fait sur Render + GitHub Actions,
# voir DEPLOIEMENT.md).

# Projet Supabase (obligatoire pour web_app.py et retrain.py hors --dry-run)
SUPABASE_URL=
SUPABASE_KEY=
# Préfixe des tables — laisse "footballbot" sauf si tu fais tourner
# plusieurs bots sur le même projet Supabase.
TABLE_PREFIX=footballbot

# The Odds API — optionnel. Sans clé, le bot utilise
# data/upcoming_matches_sample.json et ne peut pas régler les paris
# automatiquement (voir README.md).
ODDS_API_KEY=

# Sources optionnelles, AFFICHAGE UNIQUEMENT dans le journal (blessures,
# calendrier Ligue des Champions/Europa) — n'entraînent jamais le modèle
# ni n'influencent automatiquement les paris. Voir src/external_data.py.
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=

# Alertes optionnelles (Discord/Slack/Telegram) — voir alerts.py
ALERT_WEBHOOK_URL=
ALERT_CHAT_ID=
ALERT_TEST_TOKEN=

BOT_LABEL=bot de paris football virtuels
